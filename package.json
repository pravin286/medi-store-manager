{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:hostinger": "echo Using committed build artifacts",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "node deploy/server/index.js",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2",
    "express": "^5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.1",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
